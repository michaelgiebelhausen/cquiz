    }
  ],
  "narrative": {
    "northStar": "The Conversation Floor",
    "overview": "The Conversation Floor keeps attention on the person contributing and the question being explored. White surfaces, deep blue text, and orange turn controls create a bright classroom interface. The instructor console uses compact navigation and readable evidence rather than theatrical game-show decoration.",
    "keyCharacteristics": [
      "One primary student task at a time.",
      "Flat tonal surfaces and clear interaction states.",
      "A compact desktop console with mobile reflow."
    ],
    "rules": [
      {
        "name": "The Floor Rule",
        "body": "Orange identifies active contribution; blue identifies administrative actions.",
        "section": "colors"
      },
      {
        "name": "The Single Voice Rule",
        "body": "Use self-hosted Manrope for every type role; scale and weight establish hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal surfaces and spacing for depth; the shipped interface has no decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the current question and speaker visually primary.",
      "Do pair semantic colors with explicit status text.",
      "Do preserve visible keyboard focus and native radio semantics.",
      "Do identify synthetic rehearsal evidence explicitly.",
      "Do label histogram score ranges and student counts."
    ],
    "donts": [
      "Don't expose rankings or answer rubrics on student screens.",
      "Don't replace meaningful headings with topic or destination eyebrows.",
      "Don't add decorative entrance animation or game-show noise.",
      "Don't render a nonzero bar for an empty score bin."
    ]
  }
}
